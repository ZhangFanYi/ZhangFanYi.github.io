+            step = len(indices) / _MAX_VIDEO_FRAMES
+            indices = [indices[int(i * step)] for i in range(_MAX_VIDEO_FRAMES)]
+        effective_fps = source_fps / stride if stride > 0 else source_fps
+        return indices, float(effective_fps)
