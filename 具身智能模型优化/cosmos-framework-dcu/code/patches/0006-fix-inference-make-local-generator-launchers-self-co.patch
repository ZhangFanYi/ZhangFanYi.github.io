+        DEFAULT_INPUT_FILE=inputs/omni/t2i.json
+        DEFAULT_OUTPUT_DIR=outputs/inference_generator_vision_nano_nvidia_smoke
+        DEFAULT_PARALLELISM_PRESET=latency
