 examples/toml/sft_config/vision_sft_nano.toml                   | 2 +-
 .../toml/sft_config/vision_sft_nano_mapstyle_dataloader.toml    | 2 +-
 9 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/cosmos_framework/configs/base/experiment/sft/vision_sft_nano.py b/cosmos_framework/configs/base/experiment/sft/vision_sft_nano.py
index 6e04bb2..935b586 100644
--- a/cosmos_framework/configs/base/experiment/sft/vision_sft_nano.py
+++ b/cosmos_framework/configs/base/experiment/sft/vision_sft_nano.py
@@ -89,7 +89,7 @@ vision_sft_nano = LazyDict(
             project="cosmos3",
             group="sft",
             name="vision_sft_nano",
-            wandb_mode="disabled",
+            wandb_mode="offline",
         ),
         model=dict(
             config=deepcopy(VISION_NANO_MODEL_CONFIG),
diff --git a/examples/launch_sft_generator_vision_nano_cosmosdataloader_hcu.sh b/examples/launch_sft_generator_vision_nano_cosmosdataloader_hcu.sh
