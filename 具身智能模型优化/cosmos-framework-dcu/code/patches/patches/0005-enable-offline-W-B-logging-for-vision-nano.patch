+++ b/examples/launch_sft_generator_vision_nano_cosmosdataloader_hcu.sh
@@ -43,6 +43,7 @@ compgen -G "$BASE_CHECKPOINT_PATH/model/*.distcp" >/dev/null || { echo "ERROR: n
 
 TAIL_OVERRIDES=(
     "job.name=${RUN_NAME}"
+    "job.wandb_mode=offline"
     "model.config.vlm_config.tokenizer.local_processor_dir=${LOCAL_PROCESSOR_DIR}"
     "trainer.max_iter=${MAX_ITER}"
     "checkpoint.save_iter=${CHECKPOINT_SAVE_ITER}"
diff --git a/examples/launch_sft_generator_vision_nano_cosmosdataloader_nvidia_local.sh b/examples/launch_sft_generator_vision_nano_cosmosdataloader_nvidia_local.sh
