 TAIL_OVERRIDES=(
     "job.name=${RUN_NAME}"
+    "job.wandb_mode=offline"
     "model.config.vlm_config.tokenizer.pretrained_model_name=${VLM_TOKENIZER_PATH}"
     "trainer.max_iter=${MAX_ITER}"
     "checkpoint.save_iter=${CHECKPOINT_SAVE_ITER}"
diff --git a/examples/launch_sft_generator_vision_nano_hcu.sh b/examples/launch_sft_generator_vision_nano_hcu.sh
