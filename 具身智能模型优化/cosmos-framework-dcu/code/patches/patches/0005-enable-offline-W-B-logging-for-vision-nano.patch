+    "job.project=cosmos_oss_alignment" "job.wandb_mode=offline" "job.name=${RUN_NAME}"
 )
 
 source "$(dirname "${BASH_SOURCE[0]}")/_sft_launcher_common.sh"
diff --git a/examples/toml/sft_config/vision_sft_nano.toml b/examples/toml/sft_config/vision_sft_nano.toml
