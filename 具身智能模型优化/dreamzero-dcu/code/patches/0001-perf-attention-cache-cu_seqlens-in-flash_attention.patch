From 53cf4334628da9140e8e079ff93eff49458219cb Mon Sep 17 00:00:00 2001
From: EmderYi <1042164240@qq.com>
Date: Mon, 3 Aug 2026 11:21:22 +0800
Subject: [PATCH 1/5] perf(attention): cache cu_seqlens in flash_attention

Cache the uniform cu_seqlens tensor keyed by (device, batch, sequence
length) so the attention kernel is not rebuilt from a Python list every
step, avoiding synchronous H2D copies and temporary tensor churn.

For the non-uniform path, build cu_seqlens with a zero prefix plus
cumsum instead of a redundant .to(torch.int32) cast.
---
 .../dreamzero/modules/wan2_1_attention.py     | 34 ++++++++++++++++---
 1 file changed, 29 insertions(+), 5 deletions(-)

diff --git a/groot/vla/model/dreamzero/modules/wan2_1_attention.py b/groot/vla/model/dreamzero/modules/wan2_1_attention.py
index 5ffb826..0babe68 100644
--- a/groot/vla/model/dreamzero/modules/wan2_1_attention.py
+++ b/groot/vla/model/dreamzero/modules/wan2_1_attention.py
@@ -34,6 +34,29 @@ except ModuleNotFoundError:
 
 import warnings
 
+_UNIFORM_CU_SEQLENS_CACHE: dict[
+    tuple[str, int | None, int, int], torch.Tensor
+] = {}
+
+
+def _get_uniform_cu_seqlens(
+    batch_size: int,
+    sequence_length: int,
+    device: torch.device,
+) -> torch.Tensor:
+    """Return cached int32 cumulative sequence lengths for a uniform batch."""
+    cache_key = (device.type, device.index, batch_size, sequence_length)
+    cu_seqlens = _UNIFORM_CU_SEQLENS_CACHE.get(cache_key)
+    if cu_seqlens is None:
+        # 该路径每个训练 step 会执行上千次；缓存可避免从 Python list
+        # 反复构造 device tensor 所产生的同步 H2D 和临时张量。
+        cu_seqlens = torch.arange(
+            0, (batch_size + 1) * sequence_length, sequence_length,
+            dtype=torch.int32, device=device,
+        )
+        _UNIFORM_CU_SEQLENS_CACHE[cache_key] = cu_seqlens
+    return cu_seqlens
+
 
 def _gpu_supports_flash_attention():
     """FlashAttention requires Ampere (compute capability 8.0) or newer."""
@@ -140,18 +163,22 @@ def flash_attention(
     # preprocess query
     if q_lens is None:
         q = half(q.flatten(0, 1))
-        q_lens = torch.tensor([lq] * b, dtype=torch.int32, device=q.device)
+        cu_seqlens_q = _get_uniform_cu_seqlens(b, lq, q.device)
     else:
         q = half(torch.cat([u[:v] for u, v in zip(q, q_lens)]))
+        zeros = torch.zeros([1], dtype=torch.int32, device=q.device)
+        cu_seqlens_q = torch.cat([zeros, q_lens]).cumsum(0, dtype=torch.int32)
 
     # preprocess key, value
     if k_lens is None:
         k = half(k.flatten(0, 1))
         v = half(v.flatten(0, 1))
-        k_lens = torch.tensor([lk] * b, dtype=torch.int32, device=k.device)
+        cu_seqlens_k = _get_uniform_cu_seqlens(b, lk, k.device)
     else:
         k = half(torch.cat([u[:v] for u, v in zip(k, k_lens)]))
         v = half(torch.cat([u[:v] for u, v in zip(v, k_lens)]))
+        zeros = torch.zeros([1], dtype=torch.int32, device=k.device)
+        cu_seqlens_k = torch.cat([zeros, k_lens]).cumsum(0, dtype=torch.int32)
 
     q = q.to(v.dtype)
     k = k.to(v.dtype)
@@ -163,9 +190,6 @@ def flash_attention(
         warnings.warn(
             'Flash attention 3 is not available, use flash attention 2 instead.'
         )
-    zeros = torch.zeros([1], dtype=torch.int32, device=q.device)
-    cu_seqlens_q = torch.cat([zeros, q_lens]).cumsum(0).to(torch.int32)
-    cu_seqlens_k = torch.cat([zeros, k_lens]).cumsum(0).to(torch.int32)
 
     # apply attention
     if version == 3 and FLASH_ATTN_3_AVAILABLE:
