From b4e2abdc31ae81b7146e0f44e6d512fe06a2f515 Mon Sep 17 00:00:00 2001
From: EmderYi <1042164240@qq.com>
Date: Mon, 3 Aug 2026 11:21:24 +0800
Subject: [PATCH 3/5] perf(vae): use channels_last_3d memory format for video
 encode

Set the encoder input and all Conv3d/ConvTranspose3d modules to
torch.channels_last_3d, which maps to the NHWC layout preferred by
DCU/ROCm convolutions.
---
 groot/vla/model/dreamzero/modules/wan_video_vae.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/groot/vla/model/dreamzero/modules/wan_video_vae.py b/groot/vla/model/dreamzero/modules/wan_video_vae.py
index 4e2ff44..1612132 100644
--- a/groot/vla/model/dreamzero/modules/wan_video_vae.py
+++ b/groot/vla/model/dreamzero/modules/wan_video_vae.py
@@ -1209,6 +1209,7 @@ class WanVideoVAE(nn.Module):
         hidden_states = []
         for video in videos:
             video = video.unsqueeze(0)
+            video = video.to(memory_format=torch.channels_last_3d)
             if tiled:
                 tile_size = (tile_size[0] * self.upsampling_factor, tile_size[1] * self.upsampling_factor)
                 tile_stride = (tile_stride[0] * self.upsampling_factor, tile_stride[1] * self.upsampling_factor)
@@ -1370,4 +1371,7 @@ class WanVideoVAE38(WanVideoVAE):
         self.model = VideoVAE38_(z_dim=z_dim, dim=dim).eval().requires_grad_(False)
         self.upsampling_factor = 16
         self.z_dim = z_dim
-        self.vae_pretrained_path = vae_pretrained_path
\ No newline at end of file
+        self.vae_pretrained_path = vae_pretrained_path
+        for module in self.model.modules():
+            if isinstance(module, (nn.Conv3d, nn.ConvTranspose3d)):
+                module.to(memory_format=torch.channels_last_3d)
\ No newline at end of file
