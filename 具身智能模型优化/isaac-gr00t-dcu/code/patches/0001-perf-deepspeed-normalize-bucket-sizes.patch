From 0000000000000000000000000860ab484bd182b2 Mon Sep 17 00:00:00 2001
From: zhangyf9 <zhangyf9@hygon.cn>
Date: Mon, 3 Aug 2026 10:00:00 +0800
Subject: [PATCH 1/5] perf(deepspeed): use integer bucket sizes in zero2/zero3 configs

Replace the scientific-notation float values (1e9/1e8) with explicit
integers in the zero2/zero3 DeepSpeed configs and fix the
sub_group_size/reduce_bucket_size/allgather_bucket_size formatting.
---
 gr00t__configs__deepspeed__zero2_config_json gr00t__configs__deepspeed__zero3_config_json
2 files changed, 30 insertions(+), 32 deletions(-)

diff --git a/gr00t/configs/deepspeed/zero2_config.json b/gr00t/configs/deepspeed/zero2_config.json
index 1ea0620..28a76f1 100644
--- a/gr00t/configs/deepspeed/zero2_config.json
+++ b/gr00t/configs/deepspeed/zero2_config.json
@@ -1,6 +1,6 @@
 {
     "checkpoint": {
-          "load_universal": false
+        "load_universal": false
     },
     "train_batch_size": "auto",
     "train_micro_batch_size_per_gpu": "auto",
@@ -8,15 +8,15 @@
     "gradient_clipping": "auto",
     "zero_allow_untested_optimizer": true,
     "fp16": {
-      "enabled": "auto",
-      "loss_scale": 0,
-      "loss_scale_window": 1000,
-      "initial_scale_power": 16,
-      "hysteresis": 2,
-      "min_loss_scale": 1
+        "enabled": "auto",
+        "loss_scale": 0,
+        "loss_scale_window": 1000,
+        "initial_scale_power": 16,
+        "hysteresis": 2,
+        "min_loss_scale": 1
     },
     "bf16": {
-      "enabled": "auto"
+        "enabled": "auto"
     },
     "communication_data_type": "bf16",
     "zero_optimization": {
@@ -25,9 +25,8 @@
         "reduce_scatter": true,
         "allgather_partitions": true,
         "contiguous_gradients": true,
-        "sub_group_size": 1e9,
-        "reduce_bucket_size": 1e8,
-        "allgather_bucket_size": 1e8
+        "sub_group_size": 1000000000.0,
+        "reduce_bucket_size": 100000000,
+        "allgather_bucket_size": 100000000
     }
-  }
-  
\ No newline at end of file
+}
\ No newline at end of file
diff --git a/gr00t/configs/deepspeed/zero3_config.json b/gr00t/configs/deepspeed/zero3_config.json
index e6162b3..7c12aae 100644
--- a/gr00t/configs/deepspeed/zero3_config.json
+++ b/gr00t/configs/deepspeed/zero3_config.json
@@ -5,27 +5,26 @@
     "gradient_clipping": "auto",
     "zero_allow_untested_optimizer": true,
     "fp16": {
-      "enabled": "auto",
-      "loss_scale": 0,
-      "loss_scale_window": 1000,
-      "initial_scale_power": 16,
-      "hysteresis": 2,
-      "min_loss_scale": 1
+        "enabled": "auto",
+        "loss_scale": 0,
+        "loss_scale_window": 1000,
+        "initial_scale_power": 16,
+        "hysteresis": 2,
+        "min_loss_scale": 1
     },
     "bf16": {
-      "enabled": "auto"
+        "enabled": "auto"
     },
     "zero_optimization": {
-      "stage": 3,
-      "overlap_comm": true,
-      "contiguous_gradients": true,
-      "sub_group_size": 1e9,
-      "reduce_bucket_size": "auto",
-      "stage3_prefetch_bucket_size": "auto",
-      "stage3_param_persistence_threshold": "auto",
-      "stage3_max_live_parameters": 1e9,
-      "stage3_max_reuse_distance": 1e9,
-      "stage3_gather_16bit_weights_on_model_save": true
+        "stage": 3,
+        "overlap_comm": true,
+        "contiguous_gradients": true,
+        "sub_group_size": 1000000000.0,
+        "reduce_bucket_size": 500000000.0,
+        "stage3_prefetch_bucket_size": 500000000.0,
+        "stage3_param_persistence_threshold": 1000000.0,
+        "stage3_max_live_parameters": 1000000000.0,
+        "stage3_max_reuse_distance": 1000000000.0,
+        "stage3_gather_16bit_weights_on_model_save": true
     }
-  }
-  
\ No newline at end of file
+}
\ No newline at end of file
-- 
2.31.1
