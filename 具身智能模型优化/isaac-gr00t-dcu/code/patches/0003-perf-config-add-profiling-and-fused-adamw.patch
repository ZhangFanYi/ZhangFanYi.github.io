From 000000000000000000000000e014ccca2936838e Mon Sep 17 00:00:00 2001
From: zhangyf9 <zhangyf9@hygon.cn>
Date: Mon, 3 Aug 2026 10:00:00 +0800
Subject: [PATCH 3/5] perf(config): add enable_profiling flag and use fused AdamW

Add an enable_profiling flag to the finetune config and switch the
optimizer from adamw_torch to adamw_torch_fused.
---
 gr00t__configs__finetune_config_py gr00t__experiment__launch_finetune_py
2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/gr00t/configs/finetune_config.py b/gr00t/configs/finetune_config.py
index 15918e2..7d9b577 100644
--- a/gr00t/configs/finetune_config.py
+++ b/gr00t/configs/finetune_config.py
@@ -196,6 +196,9 @@ class FinetuneConfig:
     The processor (tokenizer/config) is still loaded from base_model_path.
     Useful for CI/testing to skip the slow checkpoint shard loading."""
 
+    enable_profiling: bool = False
+    """If True, enable torch profiler during training."""
+
     def __post_init__(self) -> None:
         if self.gradient_accumulation_steps < 1:
             raise ValueError(
diff --git a/gr00t/experiment/launch_finetune.py b/gr00t/experiment/launch_finetune.py
index 00cb3ef..9b70280 100644
--- a/gr00t/experiment/launch_finetune.py
+++ b/gr00t/experiment/launch_finetune.py
@@ -6,7 +6,7 @@
 # You may obtain a copy of the License at
 #
 # http://www.apache.org/licenses/LICENSE-2.0
-#
+
 # Unless required by applicable law or agreed to in writing, software
 # distributed under the License is distributed on an "AS IS" BASIS,
 # WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
@@ -103,7 +103,8 @@ if __name__ == "__main__":
 
     config.training.experiment_name = ft_config.experiment_name
     config.training.start_from_checkpoint = ft_config.base_model_path
-    config.training.optim = "adamw_torch"
+   # config.training.optim = "adamw_torch"
+    config.training.optim = "adamw_torch_fused"
     config.training.global_batch_size = ft_config.global_batch_size
     config.training.dataloader_num_workers = ft_config.dataloader_num_workers
     config.training.learning_rate = ft_config.learning_rate
@@ -126,5 +127,6 @@ if __name__ == "__main__":
     config.training.save_only_model = ft_config.save_only_model
     config.training.resume_from_checkpoint = ft_config.resume_from_checkpoint
     config.training.skip_weight_loading = ft_config.skip_weight_loading
+    config.training.enable_profiling = ft_config.enable_profiling
 
     run(config)
-- 
2.31.1
