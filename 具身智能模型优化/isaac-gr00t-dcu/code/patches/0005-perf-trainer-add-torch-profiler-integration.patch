From 000000000000000000000000cde8f0c321c744e9 Mon Sep 17 00:00:00 2001
From: zhangyf9 <zhangyf9@hygon.cn>
Date: Mon, 3 Aug 2026 10:00:00 +0800
Subject: [PATCH 5/5] perf(trainer): add torch profiler integration

Override training_step to run a one-shot torch.profiler on rank 0 at a
configured step, printing a CUDA-time table and exporting a Chrome
trace.
---
 gr00t__experiment__trainer_py
1 file changed, 40 insertions(+), 0 deletions(-)

diff --git a/gr00t/experiment/trainer.py b/gr00t/experiment/trainer.py
index 817a000..7283efa 100755
--- a/gr00t/experiment/trainer.py
+++ b/gr00t/experiment/trainer.py
@@ -36,6 +36,7 @@ import threading
 from typing import Any, Optional
 
 import torch
+import torch.distributed as dist
 from transformers.trainer import TRAINER_STATE_NAME, Trainer, TrainerState, get_last_checkpoint
 from transformers.trainer_callback import TrainerCallback
 
@@ -247,6 +248,45 @@ class Gr00tTrainer(Trainer):
 
         return super().train(resume_from_checkpoint=latest_checkpoint, **kwargs)
 
+    # ------------------------------------------------------------------
+    # Profiling support
+    # ------------------------------------------------------------------
+    _prof_done: bool = False
+    _prof_step: int = 15
+
+    def training_step(self, model, inputs, num_items_in_batch=None):
+        step = self.state.global_step
+        rank = dist.get_rank() if dist.is_initialized() else 0
+
+        if step == self._prof_step and not self._prof_done and rank == 0:
+            print(f"\n{'='*80}")
+            print(f"Starting torch.profiler at step {step}")
+            print(f"{'='*80}\n")
+            with torch.profiler.profile(
+                activities=[
+                    torch.profiler.ProfilerActivity.CPU,
+                    torch.profiler.ProfilerActivity.CUDA,
+                ],
+                record_shapes=True,
+                profile_memory=False,
+                with_stack=True,
+            ) as prof:
+                loss = super().training_step(model, inputs, num_items_in_batch)
+            print(f"\n{'='*80}")
+            print(f"Performance profiling at step {step}")
+            print(f"{'='*80}")
+            print(prof.key_averages(group_by_input_shape=True).table(
+                sort_by="self_cuda_time_total",
+                row_limit=30,
+            ))
+            prof.export_chrome_trace("/zhangyifan/groot/outputs/dcu_prof_trace.json")
+            print(f"Trace saved to /zhangyifan/groot/outputs/dcu_prof_trace.json")
+            print(f"{'='*80}\n")
+            self._prof_done = True
+        else:
+            loss = super().training_step(model, inputs, num_items_in_batch)
+        return loss
+
     # ------------------------------------------------------------------
     # Loss / accuracy computation override
     # ------------------------------------------------------------------
-- 
