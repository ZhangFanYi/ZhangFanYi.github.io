{
    "bf16": { "enabled": true },
    "optimizer": {
        "type": "AdamW",
        "params": { "lr": 2e-5, "betas": [0.9, 0.95], "weight_decay": 0.1 }
    },
    "scheduler": {
        "type": "WarmupLR",
        "params": { "warmup_min_lr": 2e-5, "warmup_max_lr": 2e-5, "warmup_num_steps": 1 }
    },
    "zero_optimization": { "stage": 0 },
    "gradient_clipping": 1.0,
    "train_batch_size": "auto",
    "train_micro_batch_size_per_gpu": 2,
    "gradient_accumulation_steps": 8,
    "steps_per_print": 9999
}
